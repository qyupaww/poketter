    "version": "0.2.0",
    "configurations": [
        {
            "name": "Morpheme Debug Dev",
            "request": "launch",
            "type": "dart",
            "flutterMode": "debug",
            
            "program": "lib/main.dart",
            "args": [
                "--dart-define",
				"FLAVOR=dev",
				"--dart-define",
				"APP_NAME=Poketter",
				"--dart-define",
				"ANDROID_APPLICATION_ID=poketter.dev",
				"--dart-define",
				"IOS_APPLICATION_ID=poketter.dev",
				"--dart-define",
				"BASE_URL=https://pokeapi.co/api/v2"
            ]
        },
        {
